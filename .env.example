HTTP_ADDR=:8080
TENANT_ID=11111111-1111-4111-8111-111111111111
TELEGRAM_BOT_ID=123456789
TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
TELEGRAM_WEBHOOK_URL=https://bot.example.com/telegram/webhook
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai
OPENROUTER_MODEL=~typesafe/jev-latest
# Set to a vision model after approving external processing of public profile text and chat images.
OPENROUTER_CONTENT_MODEL=
# Optional: restrict the multimodal classifier to one Telegram group.
OPENROUTER_CONTENT_CHAT_ID=
# Optional: in STRICT, ban advertisers in this Telegram group after confirmation.
AUTOBAN_ADVERTISING_CHAT_ID=
OPENROUTER_BAN_MODEL=openai/gpt-4.1
# Optional: enable moderator review, campaign matching and alerts for one group.
MODERATION_OPERATIONS_CHAT_ID=
OCR_ENABLED=false
OCR_EXECUTABLE=tesseract
OCR_LANGUAGE=rus+eng
OCR_MAX_BYTES=8388608
OCR_TIMEOUT=12s
MODERATOR_CHAT_ID=
MODERATION_WORKER_HTTP_ADDR=:8082
ACTION_WORKER_HTTP_ADDR=:8081
NATS_URL=nats://127.0.0.1:4222
NATS_STREAM=TELEGRAM_EVENTS
NATS_SUBJECT=telegram.events
NATS_CONSUMER=moderation-worker
DATABASE_URL=postgres://antispambee:local-development-only@127.0.0.1:5432/antispambee?sslmode=disable
POSTGRES_PASSWORD=replace-with-strong-password
